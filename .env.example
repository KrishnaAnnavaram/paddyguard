# Copy to .env and fill in. Leave a value empty to use the default.
# The Open-Meteo archive needs no key. paddyguard reads no API key.
PADDYGUARD_DATA_DIR=
PADDYGUARD_OUTPUT_DIR=
PADDYGUARD_SEED=
PADDYGUARD_IMAGE_SIZE=
PADDYGUARD_WEATHER_PROVIDER=
PADDYGUARD_WEATHER_CACHE=
PADDYGUARD_WEATHER_LAG_DAYS=
PADDYGUARD_DEVICE=
